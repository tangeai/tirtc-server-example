server:
  http_port: 9004
  trusted_proxies: []  # Add only the reverse-proxy CIDRs that set client IP headers.

log:
  level: info  # debug|info|warn|error
  format: text  # text|json

database:
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

jwt_secret: "replace-with-same-secret-as-device-server"

internal:
  key: "replace-with-an-internal-key-at-least-32-characters" # 须与 admin 及其他服务一致
admin:
  server_url: "http://127.0.0.1:9010"

tirtc:
  app_id: "your-app-id"
  access_key_id: "your-access-key-id"
  secret_key_id: "your-secret-key-id"

tirtc_aichat:
  base_url: "https://api-tirtc.tange365.com"
  base_role_url: "https://openapi-cn01.tange365.com"
  default_role_id: "fin63bby1og0"
  # Per-user creation limits for cloud resources tracked locally.
  resource_quota:
    mcp: 4
    device_plugin: 20
    kb: 5
  # Resources visible to every user on top of their own (id+name pairs, written
  # back from the tange cloud). Leave a type empty if it has no defaults.
  default_resources:
    mcp: []
    device_plugin: []
    kb: []
