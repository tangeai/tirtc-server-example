server:
  # Per-instance request budgets; restart after changing. Omitted classes use these defaults.
  request_limits:
    token: {concurrency: 128, timeout: 10s}
    query: {concurrency: 64, timeout: 10s}
    upload: {concurrency: 8, timeout: 25s}
    upstream: {concurrency: 32, timeout: 25s}
  http_port: 9002
  trusted_proxies: []  # Add only the reverse-proxy CIDRs that set client IP headers.

log:
  level: info  # debug|info|warn|error
  format: text  # text|json

database:
  # Per-process pool limits; changes require a restart. Budget across all instances.
  max_open_conns: 50
  max_idle_conns: 10
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

mqtt:
  broker: "mqtts://mqtt-open.tangeopen.com:8883"
  # 二选一，不要同时填：
  # clientid 认证模式（单实例，ClientID 固定，在 EMQX 内置数据库注册对应 ClientID）
  client_id: "usrsrv"
  # username 认证模式（多实例，实际 ClientID 自动加 hostname 后缀，在 EMQX 注册对应 username）
  # username: "usrsrv"
  password: "replace-with-mqtt-password"

jwt_secret: "replace-with-a-strong-random-secret"

internal:
  key: "replace-with-an-internal-key-at-least-32-characters" # 服务间接口与动态配置读取共用
admin:
  server_url: "http://127.0.0.1:9000"

call:
  server_url: "http://127.0.0.1:9005"

ai:
  server_url: "http://127.0.0.1:9004"

voip:
  server_url: "http://127.0.0.1:9003"

# 设备启动服务发现。生产环境启用后填写设备实际可访问的公网地址。
discovery:
  enabled: false
  device_server_url: "http://thing.example.com"
  user_server_url: "http://thing.example.com"
  voip_server_url: "http://thing.example.com"
  ai_server_url: "http://thing.example.com"
  call_server_url: "http://thing.example.com"
  recognition_server_url: "http://thing.example.com" # 可选；需代理 /v1/recognition/ 到 9006
  mqtt_url: "mqtts://mqtt.example.com:8883"
  tirtc_endpoint: "https://your-tirtc-endpoint"

# 未发布 Admin user.bind_attempt_policy 时使用；按用户统计验证码绑定错误和按设备 ID 绑定的探测失败（设备不存在、已被他人绑定、指纹不符等），两者共用同一失败额度。
bind_attempt:
  window: "10m"
  max_failures: 10
  cooldown: "1h"

# 未发布后台配置时使用；链接顺序即展示顺序，最多 3 项。
navigation:
  links: []
  # - name: "接入文档"
  #   url: "https://docs.example.com"
  #   enabled: true

# 未发布 Admin 语言配置时使用；各服务独立配置。
web:
  # 未发布 Admin web.site 时的本地回退；英文名留空时沿用 name。
  site:
    name: "探鸽 · 小钛"
    name_en: "Tange · Xiaotai"
    public_url: ""  # 正式 HTTPS 根地址；用于 canonical、分享与站点地图
  language:
    default: auto  # auto | zh-CN | en；海外站选择 en
    allow_switch: true
