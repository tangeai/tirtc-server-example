server:
  http_port: 9002

log:
  level: info  # debug|info|warn|error
  format: text  # text|json

database:
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

mqtt:
  broker: "mqtts://mqtt-open.tangeopen.com:8883"
  # 二选一，不要同时填：
  # clientid 认证模式（单实例，ClientID 固定，在 EMQX 内置数据库注册对应 ClientID）
  client_id: "usrsrv"
  # username 认证模式（多实例，实际 ClientID 自动加 hostname 后缀，在 EMQX 注册对应 username）
  # username: "usrsrv"
  password: "replace-with-mqtt-password"

jwt_secret: "replace-with-a-strong-random-secret"

# 业务参数（全部可选，缺省使用括号内默认值）
service:
  quota_per_user: 10        # 兼容字段；当前注册不读取，配额来自 users.bind_quota 默认值
  code_ttl: 190s            # 验证码有效期（默认 190s）
  rate_limit_window: 190s   # 设备上报限频窗口（默认 190s）
  rate_limit_max_hits: 10   # 设备上报窗口内最大请求数（默认 10）
  token_expiry: 168h        # JWT 有效期（默认 7 天）
  mqtt_ack_timeout: 5s      # MQTT 下发等待 ACK 超时（默认 5s）

# 解绑清理：三个业务服务共用同一个 X-Internal-Key
call:
  internal_key: "your-internal-service-key"
  call_server_url: "http://127.0.0.1:9005"

ai:
  server_url: "http://127.0.0.1:9004"

voip:
  server_url: "http://127.0.0.1:9003"

yidun:
  captcha_id: "replace-with-captcha-id"
  secret_id: "replace-with-secret-id"
  secret_key: "replace-with-secret-key"

smtp:
  host: "smtp.example.com"
  port: 465
  username: "no-reply@example.com"
  password: "replace-with-smtp-password"
  from: "no-reply@example.com"

tirtc:
  app_id: "replace-with-app-id"
  access_key_id: "replace-with-access-key-id"
  secret_key_id: "replace-with-secret-key-id"
  endpoint: ""   # 留空则使用 SDK 默认 endpoint

# Agent 角色管理（可选，不配则 /v1/roles 等路由不启用）
tirtc_aichat:
  base_url: "https://api-tirtc.tange365.com"
  default_role_id: "fin63bby1og0"
  # base_role_url: "https://openapi-cn01.tange365.com"  # 可选，角色 CRUD API 独立地址；留空则回退到 base_url
