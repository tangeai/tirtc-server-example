server:
  http_port: 9002
  trusted_proxies: []  # Add only the reverse-proxy CIDRs that set client IP headers.

log:
  level: info  # debug|info|warn|error
  format: text  # text|json

database:
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

mqtt:
  broker: "mqtts://mqtt-open.tangeopen.com:8883"
  # 二选一，不要同时填：
  # clientid 认证模式（单实例，ClientID 固定，在 EMQX 内置数据库注册对应 ClientID）
  client_id: "usrsrv"
  # username 认证模式（多实例，实际 ClientID 自动加 hostname 后缀，在 EMQX 注册对应 username）
  # username: "usrsrv"
  password: "replace-with-mqtt-password"

jwt_secret: "replace-with-a-strong-random-secret"

internal:
  key: "replace-with-an-internal-key-at-least-32-characters" # 服务间接口与动态配置读取共用
admin:
  server_url: "http://127.0.0.1:9000"

call:
  server_url: "http://127.0.0.1:9005"

ai:
  server_url: "http://127.0.0.1:9004"

voip:
  server_url: "http://127.0.0.1:9003"

# 设备启动服务发现。生产环境启用后填写设备实际可访问的公网地址。
discovery:
  enabled: false
  device_server_url: "https://thing.example.com"
  user_server_url: "https://thing.example.com"
  voip_server_url: "https://thing.example.com"
  ai_server_url: "https://thing.example.com"
  call_server_url: "https://thing.example.com"
  mqtt_url: "mqtts://mqtt.example.com:8883"
  tirtc_endpoint: "https://your-tirtc-endpoint"
