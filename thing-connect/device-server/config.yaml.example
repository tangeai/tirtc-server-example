server:
  http_port: 9001
  trusted_proxies: []  # Add only the reverse-proxy CIDRs that set client IP headers.

log:
  level: info  # debug|info|warn|error
  format: text  # text|json

database:
  # Per-process pool limits; changes require a restart. Budget across all instances.
  max_open_conns: 50
  max_idle_conns: 10
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

internal:
  key: "replace-with-an-internal-key-at-least-32-characters"
admin:
  server_url: "http://127.0.0.1:9000"

# Device 以共享订阅消费心跳与 EMQX 系统连接事件，多个实例各收一份；账号需具备对应订阅权限。
# Admin 发布的 device-server/mqtt.connection 优先，YAML 仅在无发布记录时回退。
mqtt:
  broker: "mqtts://mqtt-open.tangeopen.com:8883"
  # 二选一，不要同时填：
  # clientid 认证模式（仅单实例，ClientID 固定，在 EMQX 内置数据库注册对应 ClientID）
  client_id: "devicesrv"
  # username 认证模式（多实例，实际 ClientID 为 username-SERVICE_INSTANCE_ID，每个实例的 SERVICE_INSTANCE_ID 必须不同）
  # username: "devicesrv"
  password: "replace-with-mqtt-password"

# EMQX 管理接口，用于启动时和丢失连接事件后自动核对设备在线状态。
# Admin 发布的 device-server/mqtt.broker_api 优先，YAML 仅在无发布记录时回退；url 留空表示不自动核对。
broker_api:
  url: ""  # 例如 http://127.0.0.1:18083
  api_key: ""
  api_secret: ""

jwt_secret: "replace-with-a-strong-random-secret"
