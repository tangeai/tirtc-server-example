; Set /opt/thing-connect to the absolute deployment directory before loading.
; For multiple instances, copy the corresponding program block, give it a
; unique name/port and set a unique SERVICE_INSTANCE_ID.

[program:device-server]
directory=/opt/thing-connect/device-server
command=/opt/thing-connect/device-server/device-server -c /opt/thing-connect/device-server/config.yaml
environment=GIN_MODE="release",SERVICE_INSTANCE_ID="device-1"
autostart=true
autorestart=true
startretries=5
startsecs=3
stopasgroup=true
killasgroup=true
stdout_logfile=/opt/thing-connect/logs/device-server.out.log
stderr_logfile=/opt/thing-connect/logs/device-server.err.log

[program:user-server]
directory=/opt/thing-connect/user-server
command=/opt/thing-connect/user-server/user-server -c /opt/thing-connect/user-server/config.yaml
environment=GIN_MODE="release",SERVICE_INSTANCE_ID="user-1"
autostart=true
autorestart=true
startretries=5
startsecs=3
stopasgroup=true
killasgroup=true
stdout_logfile=/opt/thing-connect/logs/user-server.out.log
stderr_logfile=/opt/thing-connect/logs/user-server.err.log

[program:voip-server]
directory=/opt/thing-connect/voip-server
command=/opt/thing-connect/voip-server/voip-server -c /opt/thing-connect/voip-server/config.yaml
environment=GIN_MODE="release",SERVICE_INSTANCE_ID="voip-1"
autostart=true
autorestart=true
startretries=5
startsecs=3
stopasgroup=true
killasgroup=true
stdout_logfile=/opt/thing-connect/logs/voip-server.out.log
stderr_logfile=/opt/thing-connect/logs/voip-server.err.log

[program:ai-server]
directory=/opt/thing-connect/ai-server
command=/opt/thing-connect/ai-server/ai-server -c /opt/thing-connect/ai-server/config.yaml
environment=GIN_MODE="release",SERVICE_INSTANCE_ID="ai-1"
autostart=true
autorestart=true
startretries=5
startsecs=3
stopasgroup=true
killasgroup=true
stdout_logfile=/opt/thing-connect/logs/ai-server.out.log
stderr_logfile=/opt/thing-connect/logs/ai-server.err.log

[program:call-server]
directory=/opt/thing-connect/call-server
command=/opt/thing-connect/call-server/call-server -c /opt/thing-connect/call-server/config.yaml
environment=GIN_MODE="release",SERVICE_INSTANCE_ID="call-1"
autostart=true
autorestart=true
startretries=5
startsecs=3
stopasgroup=true
killasgroup=true
stdout_logfile=/opt/thing-connect/logs/call-server.out.log
stderr_logfile=/opt/thing-connect/logs/call-server.err.log

[program:admin-server]
directory=/opt/thing-connect/admin-server
command=/opt/thing-connect/admin-server/admin-server -c /opt/thing-connect/admin-server/config.yaml
environment=GIN_MODE="release",SERVICE_INSTANCE_ID="admin-1"
autostart=true
autorestart=true
startretries=5
startsecs=3
stopasgroup=true
killasgroup=true
stdout_logfile=/opt/thing-connect/logs/admin-server.out.log
stderr_logfile=/opt/thing-connect/logs/admin-server.err.log

[group:thing-connect]
programs=device-server,user-server,voip-server,ai-server,call-server,admin-server
