server:
  http_port: 9005
  trusted_proxies: []  # Add only the reverse-proxy CIDRs that set client IP headers.

log:
  level: info  # debug|info|warn|error
  format: text  # text|json

database:
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

mqtt:
  broker: "mqtts://mqtt-open.tangeopen.com:8883"
  # 多实例推荐 username 模式；每个实例设置唯一 SERVICE_INSTANCE_ID。
  username: "callsrv"
  password: "replace-with-mqtt-password"

jwt_secret: "replace-with-the-same-strong-random-secret-as-other-services"

internal:
  key: "replace-with-an-internal-key-at-least-32-characters" # 须与 admin 及其他服务一致
admin:
  server_url: "http://127.0.0.1:9010"
