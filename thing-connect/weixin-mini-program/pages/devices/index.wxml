<view class="page">
  <view class="navbar">
    <text class="navbar-title">我的设备</text>
    <view class="navbar-actions">
      <view class="icon-btn" bindtap="onEditContactRemark" aria-label="联系人设置" role="button">
        <view class="icon-openid"></view>
      </view>
      <view class="icon-btn" bindtap="onConfirmLogout" aria-label="退出登录" role="button">
        <view class="icon-logout"></view>
      </view>
    </view>
  </view>

  <button class="add-fab" bindtap="goAdd" aria-label="添加设备">
    <view class="add-fab-plus" aria-hidden="true"></view>
  </button>

  <view wx:if="{{loading && !initialized}}" class="state-card">
    <view class="skeleton skeleton-title"></view>
    <view class="skeleton skeleton-line"></view>
    <view class="skeleton skeleton-actions"></view>
    <text class="state-description">正在获取设备…</text>
  </view>
  <view wx:elif="{{loadError && !deviceList.length}}" class="state-card">
    <text class="state-title">设备列表暂时无法加载</text>
    <text class="state-description">{{loadError}}</text>
    <button class="state-button" bindtap="onRetry">重新加载</button>
  </view>
  <view wx:elif="{{initialized && !deviceList.length}}" class="state-card">
    <view class="empty-symbol">＋</view>
    <text class="state-title">添加你的第一台设备</text>
    <text class="state-description">绑定后，即可实时查看、与设备通话，或设置 AI 角色。</text>
    <button class="state-button" bindtap="goAdd">添加设备</button>
  </view>
  <view wx:else class="device-list">
    <view wx:if="{{loadError}}" class="refresh-warning" bindtap="onRetry">{{loadError}} · 点击重试</view>
    <text wx:elif="{{loading}}" class="refresh-note">正在更新设备状态…</text>
    <view wx:for="{{deviceList}}" wx:key="device_id" class="device-card">
      <view class="device-heading">
        <view class="device-avatar {{item.online ? '' : 'device-avatar-offline'}}">
          <view class="device-glyph"></view>
        </view>
        <view class="device-identity">
          <text class="device-name">{{item.device_name || '未命名设备'}}</text>
          <view class="device-presence">
            <view class="presence-dot {{item.online ? 'presence-online' : ''}}"></view>
            <text>{{item.online ? '在线' : '离线'}}</text>
          </view>
        </view>
        <button class="more-button" data-id="{{item.device_id}}" bindtap="onDeviceMenu" aria-label="设备管理">
          <view class="more-dot"></view><view class="more-dot"></view><view class="more-dot"></view>
        </button>
      </view>
      <text class="device-id" selectable>设备 ID：{{item.device_id}}</text>
      <view class="device-context">
        <text>{{item.online ? '随时查看，与家人保持联系' : '请检查设备电源和网络连接'}}</text>
      </view>
      <view class="primary-actions">
        <button wx:if="{{item.voipAuthed}}" class="device-action action-call" disabled="{{!item.online}}" data-id="{{item.device_id}}" bindtap="onCall">{{item.callButtonText}}</button>
        <button wx:else class="device-action action-call" data-id="{{item.device_id}}" bindtap="onAuthorize">{{item.voipAuthState === 'disabled' ? '开启通话提醒' : (item.voipAuthState === 'unknown' ? '刷新通话授权' : '授权呼入')}}</button>
        <button class="device-action action-live" disabled="{{!item.online}}" data-id="{{item.device_id}}" bindtap="onOpenLive">查看画面</button>
      </view>
      <view class="device-footer">
        <button class="role-button" data-id="{{item.device_id}}" bindtap="onOpenAgent"><text class="role-mark">AI</text>角色设置 <text class="role-arrow">›</text></button>
        <text wx:if="{{item.deviceNamePending}}" class="auth-status auth-pending" bindtap="onDeviceNamePendingHelp">来电名称待更新</text>
        <text wx:elif="{{item.voipAuthed}}" class="auth-status">微信通话已授权</text>
        <text wx:else class="auth-status">{{item.voipAuthState === 'disabled' ? '通话提醒已关闭' : (item.voipAuthState === 'unknown' ? '通话授权待确认' : '首次通话需微信授权')}}</text>
      </view>
    </view>
    <text class="list-footnote" wx:if="{{deviceList.length}}">下拉可刷新设备状态</text>
  </view>

  <view wx:if="{{authNameModalVisible}}" class="auth-name-mask" catchtap="noop" catchtouchmove="noop">
    <view class="auth-name-dialog">
      <text class="auth-name-title">{{authNameMode === 'profile' ? '联系人设置' : '设置联系人名称'}}</text>
      <view wx:if="{{authNameMode === 'profile'}}" class="profile-openid-card">
        <view class="profile-openid-header">
          <text class="profile-openid-label">微信 OpenID</text>
          <text wx:if="{{profileOpenId}}" class="profile-openid-copy" bindtap="onCopyProfileOpenId" role="button">复制</text>
          <text wx:elif="{{profileOpenIdError}}" class="profile-openid-copy" bindtap="loadProfileOpenId" role="button">重试</text>
        </view>
        <text class="profile-openid-value" selectable>{{profileOpenId || (profileOpenIdError ? '获取失败，请点击重试' : '正在获取…')}}</text>
      </view>
      <text class="auth-name-subtitle">设备来电时显示的联系人名称，所有已授权设备共用。</text>
      <input
        class="auth-name-input"
        value="{{authName}}"
        maxlength="64"
        focus="{{authNameModalVisible}}"
        placeholder="请输入联系人名称"
        bindinput="onAuthNameInput"
      />
      <view class="auth-name-suggestions">
        <text class="auth-name-suggestions-label">常用称呼</text>
        <view class="auth-name-tags">
          <view
            wx:for="{{authNameSuggestions}}"
            wx:key="*this"
            class="auth-name-tag {{authName === item ? 'auth-name-tag-active' : ''}}"
            data-name="{{item}}"
            bindtap="onSelectAuthName"
          >{{item}}</view>
        </view>
      </view>
      <view class="auth-name-actions">
        <button class="auth-name-button auth-name-cancel" bindtap="onCancelAuthName">取消</button>
        <button class="auth-name-button auth-name-confirm" bindtap="onConfirmAuthName">{{authNameMode === 'profile' ? '保存名称' : '确认并授权'}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{deviceNameModalVisible}}" class="auth-name-mask" catchtap="noop" catchtouchmove="noop">
    <view class="auth-name-dialog">
      <text class="auth-name-title">设置设备名称</text>
      <text class="auth-name-subtitle">该名称会用于微信授权和手机端设备来电显示，最多 13 个字符。</text>
      <input
        class="auth-name-input"
        value="{{editingDeviceName}}"
        maxlength="13"
        focus="{{deviceNameModalVisible}}"
        placeholder="例如：客厅学习机"
        bindinput="onDeviceNameInput"
      />
      <view class="auth-name-actions">
        <button class="auth-name-button auth-name-cancel" bindtap="onCancelDeviceName">取消</button>
        <button class="auth-name-button auth-name-confirm" bindtap="onConfirmDeviceName">{{continueAuthorizeAfterName ? '保存并继续授权' : '保存名称'}}</button>
      </view>
    </view>
  </view>
</view>
