<!-- thing-connect/weixin-mini-program/pages/bind/index.wxml -->
<view class="page">
  <!-- Tab 切换 -->
  <view class="tabs">
    <view class="tab {{activeTab === 'code' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="code">验证码绑定</view>
    <view class="tab {{activeTab === 'id' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="id">设备ID绑定</view>
  </view>

  <!-- 验证码绑定 -->
  <view wx:if="{{activeTab === 'code'}}" class="panel">
    <view class="steps">
      <text class="steps-title">操作步骤</text>
      <view class="step">
        <text class="step-no">1</text>
        <view class="step-content">
          <text class="step-heading">开机并联网</text>
          <text class="step-text">Wi-Fi 设备请先配网。</text>
          <text class="step-text">4G 设备请确认 SIM 卡可用，等待联网。</text>
        </view>
      </view>
      <view class="step">
        <text class="step-no">2</text>
        <view class="step-content">
          <text class="step-heading">获取 6 位验证码</text>
          <text class="step-text">留意设备的语音播报或屏幕提示。</text>
        </view>
      </view>
      <view class="step">
        <text class="step-no">3</text>
        <view class="step-content">
          <text class="step-heading">完成绑定</text>
          <text class="step-text">在下方输入验证码，点击“绑定设备”。</text>
        </view>
      </view>
      <text class="steps-tip">验证码已过期时，请按设备提示重新获取。</text>
    </view>
    <view class="field">
      <text class="label">6 位数字验证码</text>
      <input
        class="input input-code-big"
        type="number"
        maxlength="6"
        placeholder="000000"
        value="{{bindCode}}"
        bindinput="onBindCodeInput"
      />
    </view>
    <button class="btn-primary" bindtap="doBindByCode" disabled="{{bindLoading}}">
      {{bindLoading ? '绑定中...' : '绑定设备'}}
    </button>
  </view>

  <!-- 设备 ID 绑定 -->
  <view wx:if="{{activeTab === 'id'}}" class="panel">
    <view class="field">
      <text class="label">设备 ID</text>
      <view class="input-row">
        <input
          class="input input-device"
          placeholder="输入或扫码识别设备 ID"
          value="{{bindDeviceId}}"
          bindinput="onBindDeviceIdInput"
        />
        <button class="btn-scan" bindtap="scanDeviceId">扫码识别</button>
      </view>
      <text class="field-tip">设备 ID 会自动转为大写，支持直接扫描设备二维码</text>
    </view>
    <button class="btn-primary" bindtap="doBindById" disabled="{{bindLoading}}">
      {{bindLoading ? '绑定中...' : '确认绑定'}}
    </button>
  </view>

  <text wx:if="{{errMsg}}" class="err-msg">{{errMsg}}</text>
</view>
