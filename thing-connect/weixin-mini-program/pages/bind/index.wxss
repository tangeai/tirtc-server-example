/* thing-connect/weixin-mini-program/pages/bind/index.wxss */
.page {
  min-height: 100vh;
  background: #EDEDED;
  padding: 24rpx;
}

/* ── Tab ── */
.tabs {
  display: flex;
  background: #F5F5F5;
  border-radius: 14rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 10rpx;
}

.tab-active {
  background: #fff;
  color: #07C160;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

/* ── 面板 ── */
.panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ── 步骤说明 ── */
.steps {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.steps-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.step-no {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #07C160;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.step-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  flex: 1;
}

.steps-tip {
  display: block;
  font-size: 22rpx;
  color: #BDBDBD;
  margin-top: 4rpx;
}

/* ── 表单 ── */
.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.label {
  font-size: 24rpx;
  color: #999;
}

.input {
  background: transparent;
  padding: 0;
  font-size: 32rpx;
  color: #1A1A1A;
  border: none;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-device {
  flex: 1;
  min-width: 0;
}

.btn-scan {
  width: 188rpx;
  height: 76rpx;
  background: #E8F8EF;
  color: #07C160;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: normal;
  flex-shrink: 0;
}

.field-tip {
  font-size: 22rpx;
  color: #BDBDBD;
  line-height: 1.5;
}

.input-code-big {
  font-size: 56rpx;
  text-align: center;
  letter-spacing: 16rpx;
  font-family: monospace;
  color: #07C160;
  font-weight: 600;
}

/* ── 验证码行 ── */
.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input-code {
  flex: 1;
  font-size: 30rpx;
}

.btn-code {
  width: 220rpx;
  height: 80rpx;
  background: #E8F8EF;
  color: #07C160;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: normal;
  flex-shrink: 0;
}

.btn-code[disabled] {
  color: #BDBDBD;
  background: #F5F5F5;
}

/* ── 主按钮 ── */
.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #07C160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: normal;
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

/* ── 错误提示 ── */
.err-msg {
  display: block;
  text-align: center;
  color: #FA5151;
  font-size: 26rpx;
  margin-top: 4rpx;
}
