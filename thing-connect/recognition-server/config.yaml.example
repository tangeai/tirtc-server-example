server:
  # Per-instance request budgets; restart after changing. Omitted classes use these defaults.
  request_limits:
    token: {concurrency: 128, timeout: 10s}
    query: {concurrency: 64, timeout: 10s}
    upload: {concurrency: 8, timeout: 25s}
    upstream: {concurrency: 32, timeout: 25s}
  http_port: 9006
  trusted_proxies: []
log:
  level: info
  format: text
database:
  # Per-process pool limits; changes require a restart. Budget across all instances.
  max_open_conns: 50
  max_idle_conns: 10
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"
redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0
jwt_secret: "replace-with-same-secret-as-device-server"
internal:
  key: "replace-with-an-internal-key-at-least-32-characters"
admin:
  server_url: "http://127.0.0.1:9000"
mqtt:
  broker: "mqtt://127.0.0.1:1883"
  username: "recognition-server"
  password: "replace-with-mqtt-password"
recognition:
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  api_key: ""
  tts_url: "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
  tts_model: "qwen3-tts-flash"

push:
  delivery_policy: {enabled: true, event_ttl_seconds: 120, source_max_attempts: 3, source_capacity: 32000, delivery_capacity: 6400, wechat_requests_per_second: 50}
  # 启用识别通知时填写内网推送服务地址
  server_url: ""
