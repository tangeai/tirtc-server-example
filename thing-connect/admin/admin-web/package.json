{
  "name": "thingconnect-admin-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test src/api-client.test.ts src/error-feedback.test.ts src/password-policy.test.ts src/setup.test.ts src/pages/configuration/config-status.test.ts src/pages/access/hierarchy.test.ts",
    "check": "npm run format:check && npm run check:ui && npm test && npm run build",
    "format": "prettier --write src scripts vite.config.ts",
    "format:check": "prettier --check src scripts vite.config.ts",
    "check:ui": "node --test scripts/check-ui.test.mjs && node scripts/check-ui.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@ant-design/pro-components": "2.8.10",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "antd": "^5.27.0",
    "dayjs": "^1.11.18",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^7.1.4"
  }
}
