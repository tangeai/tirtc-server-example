server:
  # Per-instance request budgets; restart after changing. Omitted classes use these defaults.
  request_limits:
    token: {concurrency: 128, timeout: 10s}
    query: {concurrency: 64, timeout: 10s}
    upload: {concurrency: 8, timeout: 25s}
    upstream: {concurrency: 32, timeout: 25s}
  http_port: 9007
  trusted_proxies: []
log:
  level: info
  format: text
database:
  # Per-process pool limits; changes require a restart. Budget across all instances.
  max_open_conns: 50
  max_idle_conns: 10
  dsn: "root:password@tcp(127.0.0.1:3306)/thing_connect?parseTime=true&charset=utf8mb4&loc=Local"
redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0
jwt_secret: "replace-with-same-secret-as-device-server"
internal:
  key: "replace-with-an-internal-key-at-least-32-characters"
admin:
  server_url: "http://127.0.0.1:9000"
wechat:
  default_app_id: ""
  apps: {}
# 常规运营配置在 Admin 的“服务配置 → 推送服务”发布；下方为无发布记录时的回退。
push:
  template_id: "rqexMc0m1O7rVv08lXnQ-txMF_Z9v8E4VPsXeP6XxrY"
  # 填写目标模板允许的提示说明及所在位置枚举
  crying: ""
  quarrel: ""
  location: ""
  # 如需分别模板或自定义字段，在 push 下设置 notifications，覆盖上面的共用模板配置。
  # notifications:
  #   app_id: ""           # 凭证按此 AppID 从 wechat.apps 读取
  #   suggested_seconds: 60
  #   max_attempts: 5
  #   backlog_seconds: 300
  #   page: "pages/notifications/index"
  #   crying: {enabled: false, template_id: "", time_key: "time1", device_key: "character_string4", hint_key: "enum_string3", hint: "", location_key: "enum_string2", location: ""}
  #   quarrel: {enabled: false}
